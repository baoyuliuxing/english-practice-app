# ── 生产环境（Vercel Serverless 用） ──────────────────────
# 在 Vercel 项目设置 → Environment Variables 中配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ── 开发环境直连（可选，仅本地 dev 时用） ──────────────────
# 如果不部署后端，仅本地开发，可在 .env.local 中填入此变量
# 前端会直接调用 DeepSeek API（Key 会暴露在浏览器中，请勿生产使用）
# VITE_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
